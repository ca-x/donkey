# Used only when the users table is empty. Existing users are never overwritten.
DONKEY_INITIAL_ADMIN_USERNAME=admin
DONKEY_INITIAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
DONKEY_SESSION_TTL=7d

# Deprecated API Basic compatibility. The Web console uses /login and a session Cookie.
# DONKEY_ADMIN_AUTH=admin:legacy-api-password
# Set true only when a trusted reverse proxy terminates HTTPS for the admin UI.
DONKEY_ADMIN_EXTERNAL_TLS=false
# Set true only when the process listens in a container but port 5003 is bound to host loopback.
DONKEY_ADMIN_EXTERNAL_LOOPBACK=false

# Optional OpenID Connect. Configure all four values together.
# DONKEY_OIDC_ISSUER=https://id.example.com/realms/donkey
# DONKEY_OIDC_CLIENT_ID=donkey
# DONKEY_OIDC_CLIENT_SECRET=replace-me
# DONKEY_OIDC_REDIRECT_URL=https://donkey.example.com/api/auth/oidc/callback
# DONKEY_OIDC_DISPLAY_NAME=Company SSO

# Optional standard `docker login` credential for the Registry listener.
# Requires built-in TLS or DONKEY_REGISTRY_EXTERNAL_TLS=true.
# DONKEY_REGISTRY_AUTH=registry:change-me
DONKEY_REGISTRY_EXTERNAL_TLS=false

# Required to enable CONNECT. Format: username:password
# DONKEY_PROXY_AUTH=proxy:change-me
# DONKEY_CONNECT_ALLOW=registry-1.docker.io,ghcr.io
# Example NAS port remap:
# DONKEY_CONNECT_REMAP=registry.example.com:443=127.0.0.1:5443

# 32-byte base64 or 64-character hex key for encrypting upstream credentials.
DONKEY_CREDENTIAL_KEY=replace-with-64-hex-characters

DONKEY_DATA_DIR=/data
DONKEY_ADMIN_ADDR=0.0.0.0:5003
DONKEY_REGISTRY_ADDR=0.0.0.0:5443
DONKEY_MAX_CACHE_BYTES=53687091200
DONKEY_MAX_EXPORT_BYTES=21474836480
DONKEY_EXPORT_TTL=7d
DONKEY_ADAPTIVE_CHUNKING_ENABLED=true
DONKEY_AUTOMATIC_CONCURRENCY_ENABLED=true
DONKEY_CHUNK_CONCURRENCY=32
DONKEY_SCHEDULER_POLICY=balanced
DONKEY_CACHE_POLICY=balanced
DONKEY_CACHE_HIGH_WATERMARK=0.90
DONKEY_CACHE_LOW_WATERMARK=0.80
# DONKEY_CACHE_TTL=30d
DONKEY_PULL_LOGGING_ENABLED=true
DONKEY_PULL_LOG_RETENTION_DAYS=30
DONKEY_PULL_LOG_MAX_ENTRIES=10000

# Set both to enable built-in Registry TLS.
# DONKEY_TLS_CERT=/certs/fullchain.pem
# DONKEY_TLS_KEY=/certs/privkey.pem
